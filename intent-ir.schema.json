{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentIR",
  "description": "Output contract of Muse Spark 1.3 Intent Translator, input to search-pro engine.",
  "type": "object",
  "required": ["query_standalone", "lang", "mode", "plan_steps", "search_queries", "budget"],
  "properties": {
    "query_standalone": { "type": "string", "description": "Self-contained query, no pronouns." },
    "lang": { "type": "string", "enum": ["id", "en"] },
    "mode": { "type": "string", "enum": ["best", "pro", "research"] },
    "recency": { "type": "string", "enum": ["any", "7d", "30d"], "default": "any" },
    "plan_steps": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "goal"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    },
    "search_queries": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 12 },
    "budget": {
      "type": "object",
      "required": ["max_searches", "max_fetch"],
      "properties": {
        "max_searches": { "type": "integer", "minimum": 1, "maximum": 12 },
        "max_fetch": { "type": "integer", "minimum": 1, "maximum": 10 },
        "depth": { "type": "string", "enum": ["basic", "advanced"], "default": "basic" }
      }
    },
    "need_clarify": { "type": "boolean", "default": false },
    "clarify_question": { "type": "string" }
  }
}
